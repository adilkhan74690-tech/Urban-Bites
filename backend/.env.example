# Urban Bites — Backend Environment Configuration Example
# Copy this file to .env for local development

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/urban_bites

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=24h

# Initial Admin Setup Seed (used by npm run seed:admin)
INITIAL_ADMIN_EMAIL=admin@urbanbites.com
INITIAL_ADMIN_PASSWORD=change_this_secure_password_123

# Razorpay Test Mode Credentials
# Acquire from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_never_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_for_reconciliation
